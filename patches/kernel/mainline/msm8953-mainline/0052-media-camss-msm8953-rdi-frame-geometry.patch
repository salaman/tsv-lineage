 	void (*wm_set_ub_cfg)(struct vfe_device *vfe, u8 wm, u16 offset, u16 depth);
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index a8c6d5c80c33369fb0b6ebccb6cdfd7da6155f0c..acfce96481acae06a61f2c3bbcf9d1fc63831d37 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -1444,7 +1444,9 @@ static void vfe_try_format(struct vfe_line *line,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1,
+				      line->id == VFE_LINE_PIX ? 8191 :
+				      vfe_rdi_max_height(to_vfe(line)));
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
@@ -2211,6 +2213,7 @@ int msm_vfe_register_entities(struct vfe_device *vfe,
 		} else {
 			video_out->bpl_alignment = vfe_bpl_align_rdi(vfe);
 			video_out->line_based = 0;
+			video_out->max_height = vfe_rdi_max_height(vfe);
 		}
 
 		video_out->nformats = vfe->line[i].nformats;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.h b/drivers/media/platform/qcom/camss/camss-vfe.h
index a2188a81bcfc4c2a6747f92dd707972cf42998de..b1dd247eb8a02d95401709050400c50fd89182b8 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.h
+++ b/drivers/media/platform/qcom/camss/camss-vfe.h
@@ -138,6 +138,7 @@ struct vfe_subdev_resources {
 	char *pd_name;
 	bool has_vbif;
 	char *vbif_name;
+	u16 rdi_max_height; /* 0 means CAMSS_FRAME_MAX_HEIGHT_RDI */
 	const struct vfe_hw_ops *hw_ops;
 	const struct camss_formats *formats_rdi;
 	const struct camss_formats *formats_pix;
@@ -275,6 +276,12 @@ bool vfe_is_lite(struct vfe_device *vfe);
  * Return vfe hw version
  */
 u32 vfe_hw_version(struct vfe_device *vfe);
+
+static inline u32 vfe_rdi_max_height(const struct vfe_device *vfe)
+{
+	return vfe->res->rdi_max_height ?: CAMSS_FRAME_MAX_HEIGHT_RDI;
+}
