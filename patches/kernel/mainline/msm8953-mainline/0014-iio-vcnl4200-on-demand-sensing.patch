From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Paslawski <chris@paslawski.me>
Date: Sun, 25 Oct 2026 21:40:34 -0700
Subject: [PATCH] iio: light: vcnl4200: use active-force proximity acquisition

Enable the ThinkSmart View's VCNL4200 with its VDD and VIO supplies and
falling-edge interrupt. At probe, allow 2.5 ms after enabling supplies
before the first I2C access on VCNL4040 and VCNL4200.

Use active-force conversions for polled VCNL4200 proximity reads so
ambient-light sensing does not leave the IR LED pulsing continuously.
Switch to autonomous conversions only while proximity threshold events
are enabled, restoring the previous mode if that transition fails.
Keep the shared runtime PM and 16-bit output, and leave LED current,
pulse count and integration time to Android init.

Origin: Local ThinkSmart View integration
Source: https://github.com/isilweo/linux/commit/3c975d2d00da81f754a211043d706c12990b8730
Base-commit: 1c1a919fd728c881e7ccaf3cf18a3cf3055e0429
---
 .../boot/dts/qcom/apq8053-lenovo-cd-18781y.dts     | 13 +++--
 drivers/iio/light/vcnl4000.c                       | 68 ++++++++++++++++++++--
 2 files changed, 71 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
index 82a5a6de6d000ed3664ea0796715717d028c555b..fe6fa0b605077f4039535e360a77309f2243c401 100644
--- a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
+++ b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
@@ -114,20 +114,21 @@
 			compatible = "vishay,vcnl4200";
 			reg = <0x51>;
 
+			vdd-supply = <&pm8953_l10>;
+			vio-supply = <&pm8953_l6>;
+
 			interrupt-parent = <&tlmm>;
-			interrupts = <43 IRQ_TYPE_EDGE_RISING>;
+			interrupts = <43 IRQ_TYPE_EDGE_FALLING>;
 			interrupt-names = "INT1";
 
 			pinctrl-0 = <&alsp_int_default>;
 			pinctrl-names = "default";
 
 			/*
-			 * WARNING: Do not enable for now!
-			 * There's a chance that this can burn out the sensor's IR LED.
-			 * The sensor turns on the IR LED at high power (so that it
-			 * gets noticeably warm) and never turns it off.
+			 * Poll active-force measurements. Proximity threshold
+			 * events require autonomous measurement; do not enable.
 			 */
-			status = "disabled";
+			status = "okay";
 		};
 	};
 
diff --git a/drivers/iio/light/vcnl4000.c b/drivers/iio/light/vcnl4000.c
index 336468d59ea7fe555145d3aeff473ce5f8d858c5..9421dfe805dad5c3d2122983a14f81a96202217c 100644
--- a/drivers/iio/light/vcnl4000.c
+++ b/drivers/iio/light/vcnl4000.c
@@ -73,6 +73,8 @@
 #define VCNL4040_INT_FLAGS	0x0b /* Interrupt register */
 #define VCNL4200_INT_FLAGS	0x0d /* Interrupt register */
 #define VCNL4200_DEV_ID		0x0e /* Device ID, slave address and version */
+#define VCNL4200_PS_AF		BIT(3)
+#define VCNL4200_PS_TRIG		BIT(2)
 
 #define VCNL4040_DEV_ID		0x0c /* Device ID and version */
 
@@ -226,6 +228,7 @@ struct vcnl4000_chip_spec {
 	const int(*als_it_times)[][2];
 	const int num_als_it_times;
 	const unsigned int ulux_step;
+	const unsigned int power_up_delay_us;
 	const int prod_id;
 };
 
@@ -399,6 +402,8 @@ static int vcnl4200_init(struct vcnl4000_data *data)
 		return ret;
 
 	regval = ret | VCNL4040_CONF3_PS_SAMPLE_16BITS;
+	if (data->chip_spec->prod_id == VCNL4200_PROD_ID)
+		regval = (regval & ~VCNL4200_PS_TRIG) | VCNL4200_PS_AF;
 	ret = i2c_smbus_write_word_data(client, VCNL4200_PS_CONF3, regval);
 	if (ret < 0)
 		return ret;
@@ -505,7 +510,34 @@ static int vcnl4000_measure_proximity(struct vcnl4000_data *data, int *val)
 
 static int vcnl4200_measure_proximity(struct vcnl4000_data *data, int *val)
 {
-	return vcnl4200_measure(data, &data->vcnl4200_ps, val);
+	struct i2c_client *client = data->client;
+	int ret;
+
+	if (data->chip_spec->prod_id != VCNL4200_PROD_ID)
+		return vcnl4200_measure(data, &data->vcnl4200_ps, val);
+
+	guard(mutex)(&data->vcnl4000_lock);
+
+	if (data->ps_int)
+		return vcnl4200_measure(data, &data->vcnl4200_ps, val);
+
+	ret = i2c_smbus_read_word_data(client, VCNL4200_PS_CONF3);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_write_word_data(client, VCNL4200_PS_CONF3,
+				      ret | VCNL4200_PS_AF | VCNL4200_PS_TRIG);
+	if (ret < 0)
+		return ret;
+
+	/* Active-force results were measured ready after 9-10 ms on VCNL4200. */
+	fsleep(20000);
+	ret = i2c_smbus_read_word_data(client, VCNL4200_PS_DATA);
+	if (ret < 0)
+		return ret;
+
+	*val = ret;
+	return 0;
 }
 
 static int vcnl4010_read_proxy_samp_freq(struct vcnl4000_data *data, int *val,
@@ -1413,7 +1445,7 @@ static int vcnl4040_write_event_config(struct iio_dev *indio_dev,
 				       enum iio_event_direction dir,
 				       bool state)
 {
-	int ret;
+	int ret, conf3 = -1, restore_ret;
 	u16 val, mask;
 	struct vcnl4000_data *data = iio_priv(indio_dev);
 
@@ -1445,8 +1477,29 @@ static int vcnl4040_write_event_config(struct iio_dev *indio_dev,
 
 		val = state ? (ret | mask) : (ret & ~mask);
 
-		data->ps_int = FIELD_GET(VCNL4040_PS_CONF2_PS_INT, val);
-		return i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF1, val);
+		if (data->chip_spec->prod_id == VCNL4200_PROD_ID) {
+			conf3 = i2c_smbus_read_word_data(data->client, VCNL4200_PS_CONF3);
+			if (conf3 < 0)
+				return conf3;
+
+			ret = conf3 & ~(VCNL4200_PS_AF | VCNL4200_PS_TRIG);
+			if (!FIELD_GET(VCNL4040_PS_CONF2_PS_INT, val))
+				ret |= VCNL4200_PS_AF;
+			ret = i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF3, ret);
+			if (ret < 0)
+				return ret;
+		}
+		ret = i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF1, val);
+		if (ret < 0 && conf3 >= 0) {
+			restore_ret = i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF3,
+							     conf3 & ~VCNL4200_PS_TRIG);
+			if (restore_ret < 0)
+				dev_err(&data->client->dev,
+					"Failed to restore proximity mode: %d\n", restore_ret);
+		}
+		if (!ret)
+			data->ps_int = FIELD_GET(VCNL4040_PS_CONF2_PS_INT, val);
+		return ret;
 	default:
 		return -EINVAL;
 	}
@@ -1854,6 +1907,8 @@ static const struct vcnl4000_chip_spec vcnl4040_spec = {
 	.als_it_times = &vcnl4040_als_it_times,
 	.num_als_it_times = ARRAY_SIZE(vcnl4040_als_it_times),
 	.ulux_step = 100000,
+	/* Vishay application note 84307 */
+	.power_up_delay_us = 2500,
 	.prod_id = VCNL4040_PROD_ID,
 };
 
@@ -1873,6 +1928,8 @@ static const struct vcnl4000_chip_spec vcnl4200_spec = {
 	.als_it_times = &vcnl4200_als_it_times,
 	.num_als_it_times = ARRAY_SIZE(vcnl4200_als_it_times),
 	.ulux_step = 24000,
+	/* Vishay application note 84327 */
+	.power_up_delay_us = 2500,
 	.prod_id = VCNL4200_PROD_ID,
 };
 
@@ -1936,6 +1993,9 @@ static int vcnl4000_probe(struct i2c_client *client)
 	if (ret)
 		return ret;
 
+	if (data->chip_spec->power_up_delay_us)
+		fsleep(data->chip_spec->power_up_delay_us);
+
 	ret = data->chip_spec->init(data);
 	if (ret < 0)
 		return ret;
