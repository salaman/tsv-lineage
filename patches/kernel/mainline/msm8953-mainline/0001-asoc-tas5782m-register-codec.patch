Subject: [PATCH] ASoC: register the ThinkSmart TAS5782M codec

Build the locally maintained TAS5782M sources as an in-tree codec module.
The source files and their original attribution live in drivers/tas5782m.

Origin: ThinkSmart View port; see PROVENANCE.md

---
diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 2c4d8f6..a410147 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2222,6 +2222,14 @@ config SND_SOC_TAS5720
 	  Enable support for Texas Instruments TAS5720L/M high-efficiency mono
 	  Class-D audio power amplifiers.
 
+config SND_SOC_TAS5782M
+	tristate "Texas Instruments TAS5782M speaker amplifier"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Enable support for Texas Instruments TAS5782M Class-D
+	  speaker amplifier.
+
 config SND_SOC_TAS5805M
 	tristate "Texas Instruments TAS5805M speaker amplifier"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 0e1345d..f4e9e97 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -316,6 +316,7 @@ snd-soc-sti-sas-y := sti-sas.o
 snd-soc-tas5086-y := tas5086.o
 snd-soc-tas571x-y := tas571x.o
 snd-soc-tas5720-y := tas5720.o
+snd-soc-tas5782m-y := tas5782m.o tas5782m_tables.o
 snd-soc-tas5805m-y := tas5805m.o
 snd-soc-tas6424-y := tas6424.o
 snd-soc-tda7419-y := tda7419.o
@@ -759,6 +760,7 @@ obj-$(CONFIG_SND_SOC_TAS2783_SDW)	+= snd-soc-tas2783-sdw.o
 obj-$(CONFIG_SND_SOC_TAS5086)	+= snd-soc-tas5086.o
 obj-$(CONFIG_SND_SOC_TAS571X)	+= snd-soc-tas571x.o
 obj-$(CONFIG_SND_SOC_TAS5720)	+= snd-soc-tas5720.o
+obj-$(CONFIG_SND_SOC_TAS5782M)	+= snd-soc-tas5782m.o
 obj-$(CONFIG_SND_SOC_TAS5805M)	+= snd-soc-tas5805m.o
 obj-$(CONFIG_SND_SOC_TAS6424)	+= snd-soc-tas6424.o
 obj-$(CONFIG_SND_SOC_TDA7419)	+= snd-soc-tda7419.o
