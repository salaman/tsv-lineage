--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -9,6 +9,8 @@
 
 #include <linux/bitops.h>
 #include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
 #include <media/videobuf2-v4l2.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
@@ -30,6 +32,9 @@
 
 #define VENUS_MAX_FPS			240
 
+#define VENUS_QUIRK_LEGACY_SYS_INIT	BIT(0)
+#define VENUS_QUIRK_BUFFERLESS_EOS	BIT(1)
+
 extern int venus_fw_debug;
 
 struct freq_tbl {
@@ -250,6 +255,7 @@ struct venus_core {
 	unsigned long dump_core;
 	struct of_changeset *ocs;
 	bool hwmode_dev;
+	unsigned long quirks;
 };
 
 struct vdec_controls {
@@ -345,6 +351,7 @@ struct venus_buffer {
 	struct list_head reg_list;
 	u32 flags;
 	struct list_head ref_list;
+	bool queued_to_firmware;
 };
 
 struct clock_data {
@@ -457,6 +464,11 @@ enum venus_inst_modes {
  * @drain_active:	Drain sequence is in progress
  * @flags:	bitmask flags describing current instance mode
  * @dpb_ids:	DPB buffer ID's
+ * @eos_lock:		protects scheduling and cancellation of bufferless EOS work
+ * @eos_work:		delivers bufferless EOS outside the firmware IRQ thread
+ * @eos_work_enabled:	accepts one bufferless EOS per decode sequence
+ * @eos_pending:		next capture buffer must complete with LAST
+ * @eos_received:		bufferless EOS has stopped capture submission
  */
 struct venus_inst {
 	struct list_head list;
@@ -528,6 +540,11 @@ struct venus_inst {
 	bool drain_active;
 	enum venus_inst_modes flags;
 	struct ida dpb_ids;
+	spinlock_t eos_lock;
+	struct work_struct eos_work;
+	bool eos_work_enabled;
+	bool eos_pending;
+	bool eos_received;
 };
 
 #define IS_V1(core)	((core)->res->hfi_version == HFI_VERSION_1XX)
diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index 7c094009c0050bd599f63e8cc4180369bb00de62..a050cd28f1a348b7ea8cb70b39aeca55d4e8c2e8 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -502,6 +502,10 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 	struct vb2_buffer *vb = &vbuf->vb2_buf;
 	unsigned int type = vb->type;
 	struct hfi_frame_data fdata;
+	bool track_capture = inst->session_type == VIDC_SESSION_TYPE_DEC &&
+			     type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+			     (inst->core->quirks & VENUS_QUIRK_BUFFERLESS_EOS);
+	int ret;
 
 	memset(&fdata, 0, sizeof(fdata));
 	fdata.alloc_len = buf->size;
@@ -532,7 +536,12 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 		fdata.offset = 0;
 	}
 
-	return hfi_session_process_buf(inst, &fdata);
+	if (track_capture)
+		WRITE_ONCE(buf->queued_to_firmware, true);
+	ret = hfi_session_process_buf(inst, &fdata);
+	if (track_capture && ret)
+		WRITE_ONCE(buf->queued_to_firmware, false);
+	return ret;
 }
 
 static bool is_dynamic_bufmode(struct venus_inst *inst)
@@ -1362,6 +1371,9 @@ static void delayed_process_buf_func(struct work_struct *work)
 	if (!(inst->streamon_out & inst->streamon_cap))
 		goto unlock;
 
+	if (READ_ONCE(inst->eos_received))
+		goto unlock;
+
 	list_for_each_entry_safe(buf, n, &inst->delayed_process, ref_list) {
 		if (buf->flags & HFI_BUFFERFLAG_READONLY)
 			continue;
@@ -1449,6 +1461,7 @@ int venus_helper_vb2_buf_init(struct vb2_buffer *vb)
 
 	buf->size = vb2_plane_size(vb, 0);
 	buf->dma_addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+	INIT_LIST_HEAD(&buf->ref_list);
 
 	if (vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
 		list_add_tail(&buf->reg_list, &inst->registeredbufs);
@@ -1525,6 +1538,10 @@ void venus_helper_vb2_buf_queue(struct vb2_buffer *vb)
 		if (ret)
 			return;
 
+		if (V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) &&
+		    READ_ONCE(inst->eos_received))
+			return;
+
 		ret = session_process_buf(inst, vbuf);
 		if (ret)
 			return_buf_error(inst, vbuf);
@@ -1611,6 +1628,21 @@ int venus_helper_process_initial_cap_bufs(struct venus_inst *inst)
 	int ret;
 
 	v4l2_m2m_for_each_dst_buf_safe(m2m_ctx, buf, n) {
+		struct venus_buffer *vbuf = to_venus_buffer(&buf->vb);
+
+		if (inst->session_type == VIDC_SESSION_TYPE_DEC &&
+		    (inst->core->quirks & VENUS_QUIRK_BUFFERLESS_EOS)) {
+			if (READ_ONCE(vbuf->queued_to_firmware))
+				continue;
+			if (vbuf->flags & HFI_BUFFERFLAG_READONLY) {
+				if (list_empty(&vbuf->ref_list))
+					list_add_tail(&vbuf->ref_list,
+						      &inst->delayed_process);
+				schedule_work(&inst->delayed_process_work);
+				continue;
+			}
+			list_del_init(&vbuf->ref_list);
+		}
 		ret = session_process_buf(inst, &buf->vb);
 		if (ret) {
 			return_buf_error(inst, &buf->vb);
