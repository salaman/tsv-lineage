+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c
@@ -273,7 +273,7 @@ static void hfi_sys_init_done(struct venus_core *core, struct venus_inst *inst,
 		goto done;
 	}
 
-	error = hfi_parser(core, inst, pkt->data, rem_bytes);
+	error = hfi_parser(core, inst, pkt->data, rem_bytes, pkt->num_properties);
 
 done:
 	core->error = error;
@@ -506,7 +506,7 @@ static void hfi_session_init_done(struct venus_core *core,
 		goto done;
 	}
 
-	error = hfi_parser(core, inst, pkt->data, rem_bytes);
+	error = hfi_parser(core, inst, pkt->data, rem_bytes, pkt->num_properties);
 done:
 	inst->error = error;
 	complete(&inst->done);
@@ -583,6 +583,14 @@ static void hfi_session_ftb_done(struct venus_core *core,
 			buffer_type = HFI_BUFFER_OUTPUT2;
 
 		error = pkt->error_type;
+		if ((core->quirks & VENUS_QUIRK_BUFFERLESS_EOS) &&
+		    buffer_type == inst->opb_buftype &&
+		    (hfi_flags & HFI_BUFFERFLAG_EOS) &&
+		    !error && !filled_len && !pkt->packet_buffer) {
+			inst->error = HFI_ERR_NONE;
+			inst->ops->event_notify(inst, EVT_SESSION_EOS, NULL);
+			return;
+		}
 	} else {
 		error = HFI_ERR_SESSION_INVALID_PARAMETER;
 	}
diff --git a/drivers/media/platform/qcom/venus/hfi_parser.c b/drivers/media/platform/qcom/venus/hfi_parser.c
index 62fde745f754cdaaf30e360839ff171c6f7359f5..eea042ecdf8aa722c130d2699d80c5a9cb8d3e62 100644
--- a/drivers/media/platform/qcom/venus/hfi_parser.c
+++ b/drivers/media/platform/qcom/venus/hfi_parser.c
@@ -65,7 +65,8 @@ fill_buf_mode(struct hfi_plat_caps *cap, const void *data, unsigned int num)
 }
 
 static int
-parse_alloc_mode(struct venus_core *core, u32 codecs, u32 domain, void *data)
+parse_alloc_mode(struct venus_core *core, u32 codecs, u32 domain, void *data,
+		 u32 rem_bytes)
 {
 	struct hfi_buffer_alloc_mode_supported *mode = data;
 	u32 num_entries = mode->num_entries;
@@ -74,6 +75,9 @@ parse_alloc_mode(struct venus_core *core, u32 codecs, u32 domain, void *data)
 	if (num_entries > MAX_ALLOC_MODE_ENTRIES)
 		return -EINVAL;
 
+	if (struct_size(mode, data, num_entries) > rem_bytes)
+		return -EOVERFLOW;
+
 	type = mode->data;
 
 	while (num_entries--) {
@@ -101,7 +105,8 @@ static void fill_profile_level(struct hfi_plat_caps *cap, const void *data,
 }
 
 static int
-parse_profile_level(struct venus_core *core, u32 codecs, u32 domain, void *data)
+parse_profile_level(struct venus_core *core, u32 codecs, u32 domain, void *data,
+		    u32 rem_bytes)
 {
 	struct hfi_profile_level_supported *pl = data;
 	struct hfi_profile_level *proflevel = pl->profile_level;
@@ -110,6 +115,9 @@ parse_profile_level(struct venus_core *core, u32 codecs, u32 domain, void *data)
 	if (pl->profile_count > HFI_MAX_PROFILE_COUNT)
 		return -EINVAL;
 
+	if (struct_size(pl, profile_level, pl->profile_count) > rem_bytes)
+		return -EOVERFLOW;
+
 	memcpy(pl_arr, proflevel, pl->profile_count * sizeof(*proflevel));
 
 	for_each_codec(core->caps, ARRAY_SIZE(core->caps), codecs, domain,
@@ -131,7 +139,8 @@ fill_caps(struct hfi_plat_caps *cap, const void *data, unsigned int num)
 }
 
 static int
-parse_caps(struct venus_core *core, u32 codecs, u32 domain, void *data)
+parse_caps(struct venus_core *core, u32 codecs, u32 domain, void *data,
+	   u32 rem_bytes)
 {
 	struct hfi_capabilities *caps = data;
 	struct hfi_capability *cap = caps->data;
@@ -141,6 +150,9 @@ parse_caps(struct venus_core *core, u32 codecs, u32 domain, void *data)
 	if (num_caps > MAX_CAP_ENTRIES)
 		return -EINVAL;
 
+	if (struct_size(caps, data, num_caps) > rem_bytes)
+		return -EOVERFLOW;
+
 	memcpy(caps_arr, cap, num_caps * sizeof(*cap));
 
 	for_each_codec(core->caps, ARRAY_SIZE(core->caps), codecs, domain,
@@ -162,34 +174,42 @@ static void fill_raw_fmts(struct hfi_plat_caps *cap, const void *fmts,
 }
 
 static int
-parse_raw_formats(struct venus_core *core, u32 codecs, u32 domain, void *data)
+parse_raw_formats(struct venus_core *core, u32 codecs, u32 domain, void *data,
+		  u32 rem_bytes)
 {
 	struct hfi_uncompressed_format_supported *fmt = data;
-	struct hfi_uncompressed_plane_info *pinfo = &fmt->plane_info;
-	struct hfi_uncompressed_plane_constraints *constr;
 	struct raw_formats rawfmts[MAX_FMT_ENTRIES] = {};
-	u32 entries = fmt->format_entries;
+	u32 entries, num_planes, entry_size;
+	u32 size = offsetof(struct hfi_uncompressed_format_supported, plane_info);
 	unsigned int i = 0;
