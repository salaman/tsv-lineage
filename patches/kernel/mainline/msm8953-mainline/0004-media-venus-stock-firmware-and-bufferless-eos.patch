 				return HFI_ERR_SYS_INSUFFICIENT_RESOURCES;
 
 			ret = parse_codecs(core, payload);
 			if (ret < 0)
 				return HFI_ERR_SYS_INSUFFICIENT_RESOURCES;
 
+			if (counted) {
+				if (rem_bytes < ret + sizeof(u32) +
+						sizeof(struct hfi_max_sessions_supported))
+					return HFI_ERR_SYS_INSUFFICIENT_RESOURCES;
+				if (payload[ret / sizeof(u32)] !=
+				    HFI_PROPERTY_PARAM_MAX_SESSIONS_SUPPORTED)
+					return HFI_ERR_SYS_INVALID_PARAMETER;
