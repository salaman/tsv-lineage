+static void vdec_eos_enable(struct venus_inst *inst)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&inst->eos_lock, flags);
+	inst->eos_work_enabled = true;
+	spin_unlock_irqrestore(&inst->eos_lock, flags);
+}
+
+static void vdec_eos_cancel(struct venus_inst *inst)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&inst->eos_lock, flags);
+	inst->eos_work_enabled = false;
+	spin_unlock_irqrestore(&inst->eos_lock, flags);
+	cancel_work_sync(&inst->eos_work);
+}
+
+static void vdec_complete_eos(struct venus_inst *inst,
+			      struct vb2_v4l2_buffer *vbuf)
+{
+	static const struct v4l2_event eos = { .type = V4L2_EVENT_EOS };
+	struct vb2_buffer *vb = &vbuf->vb2_buf;
+
+	lockdep_assert_held(&inst->lock);
+
+	list_del_init(&to_venus_buffer(vbuf)->ref_list);
+	vbuf->flags = V4L2_BUF_FLAG_LAST;
+	vbuf->field = V4L2_FIELD_NONE;
+	vbuf->sequence = inst->sequence_cap++;
+	vb2_set_plane_payload(vb, 0, 0);
+	vb->planes[0].data_offset = 0;
+	vb->timestamp = 0;
+	inst->eos_pending = false;
+	inst->drain_active = false;
+	inst->codec_state = VENUS_DEC_STATE_STOPPED;
+	v4l2_event_queue_fh(&inst->fh, &eos);
+	v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
+}
+
+static void vdec_eos_work(struct work_struct *work)
+{
+	struct venus_inst *inst = container_of(work, struct venus_inst, eos_work);
+	struct vb2_v4l2_buffer *vbuf = NULL;
+	struct venus_buffer *buf;
+
+	mutex_lock(&inst->lock);
+	if (!inst->streamon_out || !inst->streamon_cap || inst->session_error)
+		goto unlock;
+	if (inst->codec_state != VENUS_DEC_STATE_DRAIN &&
+	    inst->codec_state != VENUS_DEC_STATE_DECODING) {
+		dev_warn_ratelimited(inst->core->dev_dec,
+				     "bufferless EOS in decoder state %u\n",
+				     inst->codec_state);
+		goto unlock;
+	}
+
+	list_for_each_entry(buf, &inst->registeredbufs, reg_list) {
+		if (READ_ONCE(buf->queued_to_firmware))
+			continue;
+		vbuf = venus_helper_find_buf(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+					    buf->vb.vb2_buf.index);
+		if (vbuf)
+			break;
+	}
+	if (vbuf)
+		vdec_complete_eos(inst, vbuf);
+	else
+		inst->eos_pending = true;
+unlock:
+	mutex_unlock(&inst->lock);
+}
