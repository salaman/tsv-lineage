+		size += entry_size;
+
+		if (i >= MAX_FMT_ENTRIES)
+			continue;
 
-		size += sizeof(*constr) * num_planes + 2 * sizeof(u32);
-		pinfo = (void *)pinfo + sizeof(*constr) * num_planes +
