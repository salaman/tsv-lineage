+static void vdec_reset_capture_ownership(struct venus_inst *inst)
+{
+	struct venus_buffer *buf;
+
+	lockdep_assert_held(&inst->lock);
+
+	/* A completed flush releases output targets, not necessarily DPB refs. */
+	if (!(inst->core->quirks & VENUS_QUIRK_BUFFERLESS_EOS))
+		return;
+	list_for_each_entry(buf, &inst->registeredbufs, reg_list) {
+		WRITE_ONCE(buf->queued_to_firmware, false);
+		list_del_init(&buf->ref_list);
+	}
+}
