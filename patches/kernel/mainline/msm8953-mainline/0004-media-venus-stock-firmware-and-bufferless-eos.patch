+static void vdec_eos_enable(struct venus_inst *inst)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&inst->eos_lock, flags);
+	inst->eos_work_enabled = true;
+	spin_unlock_irqrestore(&inst->eos_lock, flags);
+}
+
+static void vdec_eos_cancel(struct venus_inst *inst)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&inst->eos_lock, flags);
+	inst->eos_work_enabled = false;
+	spin_unlock_irqrestore(&inst->eos_lock, flags);
+	cancel_work_sync(&inst->eos_work);
+}
+
+static void vdec_queue_eos(struct venus_inst *inst)
+{
+	unsigned long flags;
+
+	/* IRQ processing must remain able to complete a concurrent flush. */
+	spin_lock_irqsave(&inst->eos_lock, flags);
+	if (inst->eos_work_enabled) {
+		inst->eos_work_enabled = false;
+		WRITE_ONCE(inst->eos_received, true);
+		schedule_work(&inst->eos_work);
+	}
+	spin_unlock_irqrestore(&inst->eos_lock, flags);
+}
