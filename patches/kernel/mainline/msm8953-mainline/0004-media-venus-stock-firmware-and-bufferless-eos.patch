-	u32 *frame_size = buf + size;
 	u32 rem_bytes = size;
+	bool counted = (core->quirks & VENUS_QUIRK_LEGACY_SYS_INIT) && !inst;
 	int ret;
 
 	ret = hfi_platform_parser(core, inst);
@@ -316,55 +336,74 @@ u32 hfi_parser(struct venus_core *core, struct venus_inst *inst, void *buf,
 		memset(core->caps, 0, sizeof(core->caps));
