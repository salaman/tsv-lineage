 arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
index 175fad331479..c9ce485920d3 100644
--- a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
+++ b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
@@ -508,7 +508,7 @@ pm8953_l11: l11 {
 
 		pm8953_l12: l12 {
 			regulator-min-microvolt = <1800000>;
-			regulator-max-microvolt = <2950000>;
+			regulator-max-microvolt = <1800000>;
 		};
 
 		pm8953_l13: l13 {
