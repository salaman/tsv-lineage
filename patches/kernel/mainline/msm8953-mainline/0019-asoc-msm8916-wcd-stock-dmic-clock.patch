+			return dev_err_probe(dev, ret, "Invalid DMIC clock property\n");
+		if (priv->dmic_clk_rate < 600000 || priv->dmic_clk_rate > 6144000)
+			return dev_err_probe(dev, -EINVAL, "Invalid DMIC clock limit %u\n",
+					     priv->dmic_clk_rate);
+	}
 
 	base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(base))
