+#include <linux/bitfield.h>
 #include <linux/module.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
@@ -226,6 +227,7 @@
 
 struct msm8916_wcd_digital_priv {
 	struct clk *ahbclk, *mclk;
+	u32 dmic_clk_rate;
 };
 
 static const unsigned long rx_gain_reg[] = {
@@ -594,21 +596,52 @@
 	return 0;
 }
 
+static int msm8916_wcd_digital_dmic_clk_sel(struct snd_soc_component *component)
+{
+	static const unsigned int divs[] = { 2, 3, 4, 6, 16 };
+	struct msm8916_wcd_digital_priv *priv = snd_soc_component_get_drvdata(component);
+	unsigned long mclk_rate;
+	unsigned int sel;
+
+	if (!priv->dmic_clk_rate)
+		return TXN_DMIC_CTL_CLK_SEL_DIV3;
+
+	mclk_rate = clk_get_rate(priv->mclk);
+	if (!mclk_rate) {
+		dev_err(component->dev, "Cannot select DMIC clock without MCLK\n");
+		return -EINVAL;
+	}
+
+	for (sel = 0; sel < ARRAY_SIZE(divs); sel++)
+		if (mclk_rate <= (u64)priv->dmic_clk_rate * divs[sel])
+			return sel;
+
+	dev_err(component->dev, "Cannot divide MCLK %lu below DMIC limit %u\n",
+		mclk_rate, priv->dmic_clk_rate);
+	return -EINVAL;
+}
+
 static int msm8916_wcd_digital_enable_dec(struct snd_soc_dapm_widget *w,
 					  struct snd_kcontrol *kcontrol,
