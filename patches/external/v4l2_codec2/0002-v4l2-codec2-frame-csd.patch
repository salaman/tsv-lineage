@@ -7,6 +7,7 @@
 
 #include <atomic>
 #include <memory>
+#include <vector>
 
 #include <C2Component.h>
 #include <C2ComponentFactory.h>
@@ -66,7 +67,8 @@ protected:
     void pumpPendingWorks();
 
     void processCSDWork(const int32_t bitstreamId, const C2Work* work);
-    void processWork(const int32_t bitstreamId, const C2Work* work);
+    virtual bool needsCSDWithAccessUnit() const { return false; }
+    void processWork(const int32_t bitstreamId, C2Work* work);
     void processWorkBuffer(const int32_t bitstreamId, const C2ConstLinearBlock& linearBlock);
 
     // Get the buffer pool.
@@ -121,6 +123,9 @@ protected:
     // reportAbandonedWorks() (drain is cancelled and works are abandoned).
     bool mIsDraining = false;
 
+    std::vector<uint8_t> mPendingCSD;
+    std::shared_ptr<C2BlockPool> mCSDInputPool;
+
     // The mutex lock to synchronize start/stop/reset/release calls.
     std::mutex mStartStopLock;
 
diff --git a/v4l2/include/v4l2_codec2/v4l2/V4L2DecodeComponent.h b/v4l2/include/v4l2_codec2/v4l2/V4L2DecodeComponent.h
index dbb607f..3094367 100644
--- a/v4l2/include/v4l2_codec2/v4l2/V4L2DecodeComponent.h
+++ b/v4l2/include/v4l2_codec2/v4l2/V4L2DecodeComponent.h
@@ -19,6 +19,8 @@ public:
     void startTask(c2_status_t* status, ::base::WaitableEvent* done) override;
 
 private:
+    bool needsCSDWithAccessUnit() const override { return true; }
+
     static std::atomic<int32_t> sConcurrentInstances;
     static std::atomic<uint32_t> sNextDebugStreamId;
 };
