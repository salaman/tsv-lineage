+
+    struct v4l2_format format = {};
+    format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    if (mDevice->ioctl(VIDIOC_G_FMT, &format) != 0) {
+        if (errno == EINVAL) {
+            ALOGI("Deferring CAPTURE setup until the first SOURCE_CHANGE");
