+bool H264NalParser::findVisibleRect(Rect* visibleRect) {
+    if (!visibleRect || length() <= 1 || type() != kSPSType) return false;
+    NALBitReader br(data() + 1, length() - 1);
+    return parseSPSHeader(br, visibleRect);
