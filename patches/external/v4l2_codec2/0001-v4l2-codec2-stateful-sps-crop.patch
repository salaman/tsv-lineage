+
+bool NalParser::makeVisibleRect(uint64_t width, uint64_t height, uint32_t unitX, uint32_t unitY,
+                               uint32_t left, uint32_t right, uint32_t top, uint32_t bottom,
+                               Rect* visibleRect) {
+    const uint64_t x = uint64_t(left) * unitX;
+    const uint64_t y = uint64_t(top) * unitY;
+    const uint64_t endX = uint64_t(right) * unitX;
+    const uint64_t endY = uint64_t(bottom) * unitY;
+    if (width > std::numeric_limits<int32_t>::max() ||
+        height > std::numeric_limits<int32_t>::max() ||
+        x + endX >= width || y + endY >= height) {
+        return false;
+    }
+    if (visibleRect) {
+        *visibleRect = Rect(static_cast<int32_t>(x), static_cast<int32_t>(y),
+                            static_cast<int32_t>(width - endX),
+                            static_cast<int32_t>(height - endY));
+    }
     return true;
 }
 
