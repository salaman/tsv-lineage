+    auto format = mInputQueue->setFormat(inputPixelFormat, ui::Size(0, 0), inputBufferSize, 0);
     if (!format) {
         ALOGE("Failed to call IOCTL to set input format.");
         return false;
@@ -224,6 +225,17 @@
