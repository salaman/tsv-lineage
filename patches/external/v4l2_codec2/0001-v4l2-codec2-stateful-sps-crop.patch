+bool HEVCNalParser::parseSPSHeader(NALBitReader& br, Rect* visibleRect, uint32_t* sublayers) {
+    if (!br.skipBits(4)) return false;  // sps_video_parameter_set_id
+    uint32_t spsMaxSublayersMinus1;
+    if (!br.getBitsGraceful(3, &spsMaxSublayersMinus1)) return false;
+    if (!br.skipBits(1)) return false;  // sps_temporal_id_nesting_flag
+
+    if (!skipProfileTierLevel(&br, spsMaxSublayersMinus1)) return false;
+    if (sublayers) *sublayers = spsMaxSublayersMinus1;
+
+    uint32_t unused;
+    if (!parseUE(&br, &unused) || unused > 15) return false;  // sps_seq_parameter_set_id
+    uint32_t chromaFormatIdc;
+    if (!parseUE(&br, &chromaFormatIdc) || chromaFormatIdc > 3) return false;
+    if (chromaFormatIdc == 3 && !br.skipBits(1)) return false;
+    uint32_t width, height;
+    if (!parseUE(&br, &width) || !parseUE(&br, &height)) return false;
+
+    uint32_t conformanceWindowFlag;
+    if (!br.getBitsGraceful(1, &conformanceWindowFlag)) return false;
+    uint32_t left = 0, right = 0, top = 0, bottom = 0;
+    if (conformanceWindowFlag &&
+        (!parseUE(&br, &left) || !parseUE(&br, &right) ||
+         !parseUE(&br, &top) || !parseUE(&br, &bottom))) {
+        return false;
+    }
+    const uint32_t unitX = chromaFormatIdc == 1 || chromaFormatIdc == 2 ? 2 : 1;
+    const uint32_t unitY = chromaFormatIdc == 1 ? 2 : 1;
+    return makeVisibleRect(width, height, unitX, unitY, left, right, top, bottom, visibleRect);
+}
+
+bool HEVCNalParser::findVisibleRect(Rect* visibleRect) {
+    if (!visibleRect || length() <= 2 || type() != kSPSType) return false;
+    NALBitReader br(data() + 2, length() - 2);
+    return parseSPSHeader(br, visibleRect);
+}
