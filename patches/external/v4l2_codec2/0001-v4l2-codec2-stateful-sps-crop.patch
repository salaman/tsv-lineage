 #include <v4l2_codec2/common/NalParser.h>
 
@@ -48,10 +49,31 @@
     if (!br->getBitsGraceful(1, &bit)) return false;
     while (bit == 0) {
         ++numZeroes;
+        if (numZeroes >= 32) return false;
         if (!br->getBitsGraceful(1, &bit)) return false;
     }
     if (!br->getBitsGraceful(numZeroes, val)) return false;
     *val += (1u << numZeroes) - 1;
