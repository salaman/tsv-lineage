+#include <gtest/gtest.h>
+#include <v4l2_codec2/common/H264NalParser.h>
+#include <v4l2_codec2/common/HEVCNalParser.h>
+
+#include <array>
+#include <limits>
+#include <vector>
+
+namespace android {
+namespace {
+
+class Bits {
+public:
+    void put(uint32_t value, unsigned count = 1) {
+        for (unsigned bit = count; bit > 0; --bit) {
+            if (mCount % 8 == 0) mData.push_back(0);
+            mData.back() |= ((value >> (bit - 1)) & 1) << (7 - mCount % 8);
+            ++mCount;
+        }
+    }
+
+    void ue(uint32_t value) {
+        const uint64_t code = uint64_t(value) + 1;
+        unsigned count = 0;
+        for (uint64_t n = code; n; n >>= 1) ++count;
+        for (unsigned i = 1; i < count; ++i) put(0);
+        for (unsigned bit = count; bit > 0; --bit) put((code >> (bit - 1)) & 1);
+    }
+
+    std::vector<uint8_t> nal(bool hevc) const {
+        std::vector<uint8_t> result = {0, 0, 0, 1};
+        result.push_back(hevc ? 0x42 : 0x67);
+        if (hevc) result.push_back(1);
+        unsigned zeros = 0;
+        for (uint8_t byte : mData) {
+            if (zeros == 2 && byte <= 3) {
+                result.push_back(3);
+                zeros = 0;
+            }
+            result.push_back(byte);
+            zeros = byte == 0 ? zeros + 1 : 0;
+        }
+        return result;
+    }
+
+private:
+    std::vector<uint8_t> mData;
+    unsigned mCount = 0;
+};
+
+std::vector<uint8_t> h264(uint32_t widthMbs, uint32_t heightUnits,
+                          std::array<uint32_t, 4> crop = {}, uint32_t chroma = 1,
+                          bool progressive = true, bool separate = false) {
+    Bits b;
+    b.put(chroma == 1 && !separate ? 66 : 100, 8);
+    b.put(0, 16);
+    b.ue(0);
+    if (chroma != 1 || separate) {
+        b.ue(chroma);
+        if (chroma == 3) b.put(separate);
+        b.ue(0);
+        b.ue(0);
+        b.put(0);
+        b.put(0);
+    }
+    b.ue(0);
+    b.ue(0);
+    b.ue(0);
+    b.ue(1);
+    b.put(0);
+    b.ue(widthMbs - 1);
+    b.ue(heightUnits - 1);
+    b.put(progressive);
+    if (!progressive) b.put(0);
+    b.put(1);
+    b.put(1);
+    for (auto value : crop) b.ue(value);
+    b.put(0);
+    return b.nal(false);
+}
+
+std::vector<uint8_t> hevc(uint32_t width, uint32_t height,
+                          std::array<uint32_t, 4> crop = {}, uint32_t chroma = 1) {
+    Bits b;
+    b.put(1, 8);
+    for (unsigned i = 0; i < 3; ++i) b.put(0, 32);
+    b.ue(0);
+    b.ue(chroma);
+    if (chroma == 3) b.put(0);
+    b.ue(width);
+    b.ue(height);
+    b.put(1);
+    for (auto value : crop) b.ue(value);
+    return b.nal(true);
+}
+
+template <typename Parser>
+bool parse(const std::vector<uint8_t>& data, Rect* rect) {
+    if (data.empty()) return false;
+    Parser parser(data.data(), data.size());
+    return parser.locateSPS() && parser.findVisibleRect(rect);
+}
+
+TEST(SpsCrop, AvcVisibleAndAllocationAreDifferent) {
+    Rect rect;
+    ASSERT_TRUE(parse<H264NalParser>(h264(40, 23, {0, 0, 0, 4}), &rect));
+    EXPECT_EQ(rect, Rect(0, 0, 640, 360));
+    ASSERT_TRUE(parse<H264NalParser>(h264(120, 68, {0, 0, 0, 4}), &rect));
+    EXPECT_EQ(rect, Rect(0, 0, 1920, 1080));
+}
+
+TEST(SpsCrop, AvcChromaOffsetsAndInterlacing) {
+    Rect rect;
+    ASSERT_TRUE(parse<H264NalParser>(h264(40, 23, {1, 2, 3, 4}), &rect));
+    EXPECT_EQ(rect, Rect(2, 6, 636, 360));
+    ASSERT_TRUE(parse<H264NalParser>(h264(40, 23, {1, 2, 3, 4}, 2), &rect));
+    EXPECT_EQ(rect, Rect(2, 3, 636, 364));
+    ASSERT_TRUE(parse<H264NalParser>(h264(40, 23, {1, 2, 3, 4}, 3, true, true), &rect));
+    EXPECT_EQ(rect, Rect(1, 3, 638, 364));
+    ASSERT_TRUE(parse<H264NalParser>(h264(45, 18, {0, 0, 0, 2}, 1, false), &rect));
+    EXPECT_EQ(rect, Rect(0, 0, 720, 568));
+}
+
+TEST(SpsCrop, HevcConformanceWindowAndChroma) {
+    Rect rect;
+    ASSERT_TRUE(parse<HEVCNalParser>(hevc(640, 368, {0, 0, 0, 4}), &rect));
+    EXPECT_EQ(rect, Rect(0, 0, 640, 360));
+    ASSERT_TRUE(parse<HEVCNalParser>(hevc(1920, 1088, {0, 0, 0, 4}), &rect));
+    EXPECT_EQ(rect, Rect(0, 0, 1920, 1080));
+    ASSERT_TRUE(parse<HEVCNalParser>(hevc(640, 368, {1, 2, 3, 4}, 2), &rect));
+    EXPECT_EQ(rect, Rect(2, 3, 636, 364));
+    ASSERT_TRUE(parse<HEVCNalParser>(hevc(640, 368, {1, 2, 3, 4}, 3), &rect));
+    EXPECT_EQ(rect, Rect(1, 3, 638, 364));
+}
+
+TEST(SpsCrop, UncroppedStreams) {
+    Rect rect;
+    ASSERT_TRUE(parse<H264NalParser>(h264(40, 30), &rect));
+    EXPECT_EQ(rect, Rect(640, 480));
+    ASSERT_TRUE(parse<HEVCNalParser>(hevc(640, 480), &rect));
+    EXPECT_EQ(rect, Rect(640, 480));
+}
+
+TEST(SpsCrop, InvalidCropAndOverflowLeaveResultUnchanged) {
+    const Rect initial(320, 240);
+    Rect rect = initial;
+    EXPECT_FALSE(parse<H264NalParser>(h264(40, 23, {320, 0, 0, 0}), &rect));
+    EXPECT_FALSE(parse<H264NalParser>(h264(0x10000000, 23), &rect));
+    EXPECT_FALSE(parse<HEVCNalParser>(hevc(0, 368), &rect));
+    EXPECT_FALSE(parse<HEVCNalParser>(hevc(640, 368, {0, 0, 0, 184}), &rect));
+    EXPECT_FALSE(parse<HEVCNalParser>(hevc(std::numeric_limits<uint32_t>::max(), 368), &rect));
+    EXPECT_EQ(rect, initial);
+}
+
+TEST(SpsCrop, TruncatedHeadersAreRejected) {
+    Rect rect;
+    auto avc = h264(40, 23, {1, 2, 3, 4});
+    auto h265 = hevc(640, 368, {1, 2, 3, 4});
+    for (size_t size = 0; size + 1 < avc.size(); ++size) {
+        EXPECT_FALSE(parse<H264NalParser>(
+                std::vector<uint8_t>(avc.begin(), avc.begin() + size), &rect));
+    }
+    for (size_t size = 0; size + 1 < h265.size(); ++size) {
+        EXPECT_FALSE(parse<HEVCNalParser>(
+                std::vector<uint8_t>(h265.begin(), h265.begin() + size), &rect));
+    }
+}
