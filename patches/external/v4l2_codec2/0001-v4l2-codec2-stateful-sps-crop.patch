         mPendingDRC = waitForDRC(buffer->dmabuf, mCodec);
 
-    mDecodeRequests.push(DecodeRequest(std::move(buffer), std::move(decodeCb)));
+    DecodeRequest request(std::move(buffer), std::move(decodeCb));
+    request.visibleRect = visibleRect;
+    mDecodeRequests.push(std::move(request));
     pumpDecodeRequest();
 }
 
