diff --git a/common/NalParser.cpp b/common/NalParser.cpp
--- a/common/NalParser.cpp
+++ b/common/NalParser.cpp
@@ -6,6 +6,7 @@
 #define LOG_TAG "NalParser"
 
 #include <algorithm>
