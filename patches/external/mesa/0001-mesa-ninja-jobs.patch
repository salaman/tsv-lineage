Subject: android: allow the board to cap nested Mesa Ninja jobs

The outer Android Ninja worker limit does not propagate to Mesa's nested
Ninja invocation. Preserve upstream behavior when no board override is set.

Origin: Local ThinkSmart View port
Base-commit: 5a6bb76986d2d111599baf18e1dcd20b5ffd02c4
Apply in filename order within this project.

---
diff --git a/android/mesa3d_cross.mk b/android/mesa3d_cross.mk
--- a/android/mesa3d_cross.mk
+++ b/android/mesa3d_cross.mk
@@ -100,7 +100,7 @@ MESON_GEN_NINJA := \
 	-Dandroid-libbacktrace=disabled                                              \
 	$(BOARD_MESA3D_MESON_ARGS)                                                   \
 
-MESON_BUILD := PATH=$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:/usr/bin:/bin:/sbin:$$PATH ninja -C $(MESON_OUT_DIR)/build
+MESON_BUILD := PATH=$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:/usr/bin:/bin:/sbin:$$PATH ninja $(BOARD_MESA3D_NINJA_ARGS) -C $(MESON_OUT_DIR)/build
 
 $(MESON_GEN_FILES_TARGET): MESON_CPU_FAMILY := $(subst arm64,aarch64,$(TARGET_$(M_TARGET_PREFIX)ARCH))
 
