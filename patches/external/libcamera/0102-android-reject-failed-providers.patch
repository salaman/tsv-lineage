From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Paslawski <chris@paslawski.me>
Date: Wed, 11 Nov 2026 21:49:35 -0800
Subject: [PATCH] android: reject failed camera providers

Check the provider's existing initialization result before publishing its
binder service. A failed initialization may leave mModule null, which the
framework's initial notifyDeviceStateChange call would dereference.
---
Base-commit: 3becb16c1fa22d79a4d7eeb75a36fc895b4b7abf

 src/android/hal/provider/service.cpp |    5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/android/hal/provider/service.cpp b/src/android/hal/provider/service.cpp
--- a/src/android/hal/provider/service.cpp
+++ b/src/android/hal/provider/service.cpp
@@ -50,6 +50,11 @@
     ABinderProcess_setThreadPoolMaxThreadCount(HWBINDER_THREAD_COUNT);
 
     std::shared_ptr<LibcameraProvider> provider = ndk::SharedRefBase::make<LibcameraProvider>();
+    if (provider->isInitFailed()) {
+        ALOGE("Could not initialize libcamera camera provider.");
+        return EXIT_FAILURE;
+    }
+
     const std::string serviceName = std::string(LibcameraProvider::descriptor) + "/libcamera/0";
 
     binder_exception_t ret =
