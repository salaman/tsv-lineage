From 0f227d2b54124b9558264a120bd4ab49b18b47c4 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 6 Nov 2026 20:47:36 +0100
Subject: [PATCH] ipa: simple: awb: Keep the white on the line

The grey world takes a bright coloured area for the light: a television in
a room lit by lamps left the walls yellow. With the new whiteCurve tuning
key, the white goes to the nearest point of the line between two neutrals
of the sensor, and the colour temperature follows from there. Without the
key nothing changes.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
Base-commit: 3becb16c1fa22d79a4d7eeb75a36fc895b4b7abf
Source: https://github.com/alessandro-fontana/android_external_libcamera/commit/0f227d2b54124b9558264a120bd4ab49b18b47c4

 src/ipa/simple/algorithms/awb.cpp |   43 +++++++++++++++++++++++++++++++++++++
 src/ipa/simple/algorithms/awb.h   |   14 ++++++++++++
 2 files changed, 57 insertions(+)

diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index e4c9d0d..206a99e 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -7,6 +7,7 @@
 
 #include "awb.h"
 
+#include <algorithm>
 #include <numeric>
 #include <stdint.h>
 
@@ -25,6 +26,27 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+int Awb::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	for (const YamlObject &point : tuningData["whiteCurve"].asList()) {
+		const auto ct = point["ct"].get<float>();
+		const auto r = point["r"].get<float>();
+		const auto b = point["b"].get<float>();
+		if (!ct || !r || !b) {
+			LOG(IPASoftAwb, Error) << "Invalid point in whiteCurve";
+			return -EINVAL;
+		}
+		whiteCurve_.push_back({ *ct, *r, *b });
+	}
+
+	if (!whiteCurve_.empty() && whiteCurve_.size() != 2) {
+		LOG(IPASoftAwb, Error) << "whiteCurve takes two points";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 int Awb::configure(IPAContext &context, const IPAConfigInfo &configInfo)
 {
 	/* A still capture in another sensor mode keeps the preview's gains. */
@@ -93,6 +115,27 @@ void Awb::process(IPAContext &context,
 
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
+
+	/*
+	 * The grey world follows what fills the scene: a bright coloured area
+	 * passes for the light. Lights lie on the white line of the sensor, so
+	 * take the point of the line nearest to the estimate.
+	 */
+	if (!whiteCurve_.empty() && sumG && sumR && sumB) {
+		const White &w0 = whiteCurve_[0];
+		const White &w1 = whiteCurve_[1];
+		const float dr = w1.r - w0.r;
+		const float db = w1.b - w0.b;
+		const float r = static_cast<float>(sumR) / sumG;
+		const float b = static_cast<float>(sumB) / sumG;
+		const float t = std::clamp(((r - w0.r) * dr + (b - w0.b) * db) /
+					   (dr * dr + db * db), 0.0f, 1.0f);
+
+		gains = { { 1 / (w0.r + t * dr), 1.0, 1 / (w0.b + t * db) } };
+		/* Temperature is linear on the line in mireds. */
+		context.activeState.awb.temperatureK =
+			1 / (1 / w0.ct + t * (1 / w1.ct - 1 / w0.ct));
+	}
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
diff --git a/src/ipa/simple/algorithms/awb.h b/src/ipa/simple/algorithms/awb.h
index ad993f3..fe436e2 100644
--- a/src/ipa/simple/algorithms/awb.h
+++ b/src/ipa/simple/algorithms/awb.h
@@ -7,6 +7,8 @@
 
 #pragma once
 
+#include <vector>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -19,6 +21,7 @@ public:
 	Awb() = default;
 	~Awb() = default;
 
+	int init(IPAContext &context, const YamlObject &tuningData) override;
 	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
 	void prepare(IPAContext &context,
 		     const uint32_t frame,
@@ -29,6 +32,17 @@ public:
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
+
+private:
+	/* A white of the sensor: R/G and B/G under a light of temperature ct */
+	struct White {
+		float ct;
+		float r;
+		float b;
+	};
+
+	/* The two ends of the sensor's white line, from the tuning file */
+	std::vector<White> whiteCurve_;
 };
 
 } /* namespace ipa::soft::algorithms */
