 {
 	if (type_ == Type::Internal || type_ == Type::Mapped) {
@@ -100,7 +115,8 @@ int CameraStream::configure()
 		case formats::NV12:
 		case formats::YUYV:
 		case formats::XRGB8888:
-			postProcessor_ = std::make_unique<PostProcessorYuv>();
+			postProcessor_ = std::make_unique<PostProcessorYuv>(
+				isFullRange(camera3Stream_->data_space));
 			break;
 
 		case formats::MJPEG:
