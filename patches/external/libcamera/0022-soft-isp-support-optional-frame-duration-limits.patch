+void Agc::setFrameDurationLimits(IPAContext &context,
+				 utils::Duration minimum,
+				 utils::Duration maximum) const
+{
+	const auto &cfg = context.configuration.agc;
+	auto &state = context.activeState.agc;
+	const int32_t sensorMin = cfg.height + cfg.vblankMin;
+	const int32_t sensorMax = cfg.height + cfg.vblankMax;
+
+	state.frameLengthMin = std::clamp<int32_t>(
+		std::ceil(minimum / cfg.lineDuration), sensorMin, sensorMax);
+	state.frameLengthMax = std::clamp<int32_t>(
+		std::floor(maximum / cfg.lineDuration), state.frameLengthMin, sensorMax);
+
+	int32_t exposureFrames = state.frameLengthMax;
+	if (maxFrameTime_ > 0us)
+		exposureFrames = std::clamp<int32_t>(
+			maxFrameTime_ / cfg.lineDuration,
+			state.frameLengthMin, state.frameLengthMax);
+	state.exposureLimit = std::max(cfg.exposureMin,
+				      exposureFrames - cfg.exposureMargin);
+}
+
+void Agc::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	const auto &limits = controls.get(controls::FrameDurationLimits);
+	if (!limits)
+		return;
+
+	if ((*limits)[0] <= 0 || (*limits)[1] < (*limits)[0]) {
+		LOG(IPASoftExposure, Error) << "Invalid frame duration limits";
+		return;
+	}
+	setFrameDurationLimits(context, (*limits)[0] * 1us, (*limits)[1] * 1us);
+}
+
 /*
  * Split the product of exposure (in lines) and gain into the two: exposure
  * first, gain only for what the exposure cannot give. Longer than the
@@ -93,8 +135,21 @@ void Agc::split(const IPAContext &context, double total,
 {
 	const auto &agc = context.configuration.agc;
 
+	const int32_t limit = context.activeState.agc.exposureLimit;
 	exposure = std::clamp(static_cast<int32_t>(std::lround(total / agc.againMin)),
-			      agc.exposureMin, agc.exposureMax);
+			      agc.exposureMin, limit);
+
+	/*
+	 * Longer frames lower the frame rate: fill the default frame, then
+	 * raise the gain up to stretchGain_, and only then stretch the frame.
+	 */
+	if (exposure > agc.exposureMax && stretchGain_ > agc.againMin) {
+		if (total / agc.exposureMax <= stretchGain_)
+			exposure = agc.exposureMax;
+		else
+			exposure = std::clamp(static_cast<int32_t>(std::lround(total / stretchGain_)),
+					      agc.exposureMax, limit);
+	}
 
 	utils::Duration time = exposure * agc.lineDuration;
 	if (flickerPeriod_ > 0us && time >= flickerPeriod_) {
@@ -113,6 +168,12 @@ int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
 	pending_ = false;
 	waited_ = 0;
 
+	const auto &timing = context.configuration.agc;
+	const utils::Duration nativeFrame =
+		(timing.height + timing.vblankMin) * timing.lineDuration;
+	setFrameDurationLimits(context, nativeFrame,
+			       std::max(nativeFrame, maxFrameTime_));
+
 	auto &agc = context.activeState.agc;
 	agc.initial = false;
 	if (!configInfo.keepState)
@@ -168,6 +229,23 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 
+	auto &state = context.activeState.agc;
+
+	/* The frame rate asked for may have changed: no frame longer than it allows. */
+	if (exposure > state.exposureLimit) {
+		int32_t nextExposure;
+		double nextGain;
+
+		split(context, exposure * again, nextExposure, nextGain);
+		exposure = nextExposure;
+		again = nextGain;
+		exposureReq_ = nextExposure;
+		gainReq_ = nextGain;
+		pending_ = true;
+		waited_ = 0;
+		return;
+	}
+
 	/*
 	 * A change reaches the sensor output some frames later. Deciding
 	 * again on frames still taken with the old values stacks corrections
