 .../libcamera/internal/software_isp/swisp_stats.h  |   11 +++
 src/ipa/simple/algorithms/awb.cpp                  |   34 +++++++-
 src/ipa/simple/algorithms/awb.h                    |    2 
 src/libcamera/software_isp/debayer_cpu.cpp         |    1 
 src/libcamera/software_isp/swstats_cpu.cpp         |   84 +++++++++++++++++++-
