+#include <gtest/gtest.h>
+#include <aidl/android/hardware/thermal/BnThermalChangedCallback.h>
+#include <dirent.h>
+
+#include "Thermal.h"
+
+namespace aidl::android::hardware::thermal::impl::linaro_generic {
+
+extern "C" struct thermal_handler* __real_thermal_init(struct thermal_ops*);
+
+extern "C" struct thermal_handler* __wrap_thermal_init(struct thermal_ops* ops) {
+    EXPECT_TRUE(ops->events.trip_high && ops->events.trip_low && ops->events.cdev_update)
+        << "Callbacks must be installed before libthermal snapshots enabled events";
+    return __real_thermal_init(ops);
+}
+
+class RecordingCallback : public BnThermalChangedCallback {
+public:
+    ndk::ScopedAStatus notifyThrottling(const Temperature& temperature) override {
+        received.push_back(temperature);
+        return ndk::ScopedAStatus::ok();
+    }
+    std::vector<Temperature> received;
+};
+
+class ThermalTest : public ::testing::Test {
+protected:
+    void SetUp() override {
+        looper = ::android::sp<Looper>::make(false);
+        createThermal();
+    }
+
+    void createThermal() {
+        try {
+            thermal = ndk::SharedRefBase::make<Thermal>(looper);
+        } catch (const char* error) {
+            FAIL() << error;
+        }
+    }
+
+    int descriptorCount() {
+        DIR* directory = opendir("/proc/self/fd");
+        EXPECT_NE(directory, nullptr);
+        if (!directory)
+            return -1;
+        int count = 0;
+        while (readdir(directory))
+            ++count;
+        closedir(directory);
+        return count;
+    }
+
+    ThrottlingSeverity severity(const std::string& name, float value,
+                               ThrottlingSeverity previous = ThrottlingSeverity::NONE) {
+        for (auto& sensor : thermal->m_config.m_temperature) {
+            if (sensor.name == name) {
+                sensor.throttlingStatus = previous;
+                return thermal->throttlingSeverity(name, value);
+            }
+        }
+        ADD_FAILURE() << "Missing configured sensor " << name;
+        return ThrottlingSeverity::NONE;
+    }
+
+    void removeSensor() {
+        thermal->m_config.m_temperature.front().name = "missing-test-sensor";
+    }
+
+    void removeCoolingDevice() {
+        thermal->m_config.m_cooling_device.front().name = "missing-test-cdev";
+    }
+
+    void trip(const std::string& name, int temperature, bool up) {
+        auto zone = thermal->getThermalZone(name);
+        ASSERT_NE(zone, nullptr);
+        EXPECT_EQ(thermal->tripCrossed(zone->id, 0, temperature, thermal.get(), up), 0);
+    }
+
+    ::android::sp<Looper> looper;
+    std::shared_ptr<Thermal> thermal;
+};
+
+TEST_F(ThermalTest, CpuThresholdsAndKernelHysteresis) {
+    EXPECT_EQ(severity("cpu0-thermal", 79.999f), ThrottlingSeverity::NONE);
+    EXPECT_EQ(severity("cpu0-thermal", 80.0f), ThrottlingSeverity::LIGHT);
+    EXPECT_EQ(severity("cpu0-thermal", 79.0f, ThrottlingSeverity::LIGHT),
+              ThrottlingSeverity::LIGHT);
+    EXPECT_EQ(severity("cpu0-thermal", 78.0f, ThrottlingSeverity::LIGHT),
+              ThrottlingSeverity::LIGHT);
+    EXPECT_EQ(severity("cpu0-thermal", 77.999f, ThrottlingSeverity::LIGHT),
+              ThrottlingSeverity::NONE);
+    EXPECT_EQ(severity("cpu0-thermal", 100.0f), ThrottlingSeverity::SHUTDOWN);
+    EXPECT_EQ(severity("cpu0-thermal", 99.0f, ThrottlingSeverity::SHUTDOWN),
+              ThrottlingSeverity::SHUTDOWN);
+    EXPECT_EQ(severity("cpu0-thermal", 97.999f, ThrottlingSeverity::SHUTDOWN),
+              ThrottlingSeverity::LIGHT);
+}
+
+TEST_F(ThermalTest, GpuThresholdsAndKernelHysteresis) {
+    EXPECT_EQ(severity("gpu-thermal", 69.999f), ThrottlingSeverity::NONE);
+    EXPECT_EQ(severity("gpu-thermal", 70.0f), ThrottlingSeverity::LIGHT);
+    EXPECT_EQ(severity("gpu-thermal", 69.0f, ThrottlingSeverity::LIGHT),
+              ThrottlingSeverity::LIGHT);
+    EXPECT_EQ(severity("gpu-thermal", 67.999f, ThrottlingSeverity::LIGHT),
+              ThrottlingSeverity::NONE);
+    EXPECT_EQ(severity("gpu-thermal", 90.0f), ThrottlingSeverity::SHUTDOWN);
+}
+
+TEST_F(ThermalTest, TemperaturesAndThresholdsReplaceOutput) {
+    std::vector<Temperature> temperatures;
+    for (int iteration = 0; iteration < 2; ++iteration) {
+        ASSERT_TRUE(thermal->getTemperatures(&temperatures).isOk());
+        ASSERT_EQ(temperatures.size(), 9u);
+        ASSERT_TRUE(thermal->getTemperaturesWithType(TemperatureType::CPU,
+                                                    &temperatures).isOk());
+        EXPECT_EQ(temperatures.size(), 8u);
+        for (const auto& sensor : temperatures) {
+            EXPECT_GT(sensor.value, -40.0f);
+            EXPECT_LT(sensor.value, 100.0f);
+        }
+    }
+    std::vector<TemperatureThreshold> thresholds;
+    for (int iteration = 0; iteration < 2; ++iteration) {
+        ASSERT_TRUE(thermal->getTemperatureThresholds(&thresholds).isOk());
+        EXPECT_EQ(thresholds.size(), 9u);
+        ASSERT_TRUE(thermal->getTemperatureThresholdsWithType(TemperatureType::GPU,
+                                                             &thresholds).isOk());
+        EXPECT_EQ(thresholds.size(), 1u);
+    }
+}
+
+TEST_F(ThermalTest, CoolingDevicesReplaceOutput) {
+    std::vector<CoolingDevice> devices;
+    for (int iteration = 0; iteration < 2; ++iteration) {
+        ASSERT_TRUE(thermal->getCoolingDevices(&devices).isOk());
+        EXPECT_EQ(devices.size(), 2u);
+        ASSERT_TRUE(thermal->getCoolingDevicesWithType(CoolingType::GPU, &devices).isOk());
+        ASSERT_EQ(devices.size(), 1u);
+        EXPECT_EQ(devices.front().name, "devfreq-1c00000.gpu");
+        EXPECT_GE(devices.front().value, 0);
+        EXPECT_LE(devices.front().value, 7);
+    }
+}
+
+TEST_F(ThermalTest, MissingSensorFailsBothQueries) {
+    removeSensor();
+    std::vector<Temperature> temperatures(1);
+    EXPECT_FALSE(thermal->getTemperatures(&temperatures).isOk());
+    EXPECT_TRUE(temperatures.empty());
+    temperatures.resize(1);
+    EXPECT_FALSE(thermal->getTemperaturesWithType(TemperatureType::CPU,
+                                                 &temperatures).isOk());
+    EXPECT_TRUE(temperatures.empty());
+}
+
+TEST_F(ThermalTest, MissingCoolingDeviceFailsBothQueries) {
+    removeCoolingDevice();
+    std::vector<CoolingDevice> devices(1);
+    EXPECT_FALSE(thermal->getCoolingDevices(&devices).isOk());
+    EXPECT_TRUE(devices.empty());
+    devices.resize(1);
+    EXPECT_FALSE(thermal->getCoolingDevicesWithType(CoolingType::GPU, &devices).isOk());
+    EXPECT_TRUE(devices.empty());
+}
+
+TEST_F(ThermalTest, CallbacksRespectTypeAndRegistrationLifecycle) {
+    auto callback = ndk::SharedRefBase::make<RecordingCallback>();
+    ASSERT_TRUE(thermal->registerThermalChangedCallbackWithType(
+        callback, TemperatureType::GPU).isOk());
+    EXPECT_FALSE(thermal->registerThermalChangedCallback(callback).isOk());
+    trip("cpu0-thermal", 80000, true);
+    EXPECT_TRUE(callback->received.empty());
+    trip("gpu-thermal", 70000, true);
+    ASSERT_EQ(callback->received.size(), 1u);
+    EXPECT_EQ(callback->received.back().throttlingStatus, ThrottlingSeverity::LIGHT);
+    trip("gpu-thermal", 67999, false);
+    ASSERT_EQ(callback->received.size(), 2u);
+    EXPECT_EQ(callback->received.back().throttlingStatus, ThrottlingSeverity::NONE);
+    ASSERT_TRUE(thermal->unregisterThermalChangedCallback(callback).isOk());
+    EXPECT_FALSE(thermal->unregisterThermalChangedCallback(callback).isOk());
+    trip("gpu-thermal", 70000, true);
+    EXPECT_EQ(callback->received.size(), 2u);
+}
+
+TEST_F(ThermalTest, ReinitializationReleasesLibraryAndDescriptors) {
+    thermal.reset();
+    const int baseline = descriptorCount();
+    ASSERT_GT(baseline, 0);
+    for (int iteration = 0; iteration < 3; ++iteration) {
+        ASSERT_NO_FATAL_FAILURE(createThermal());
+        thermal.reset();
+        EXPECT_EQ(descriptorCount(), baseline);
+    }
+}
+
+TEST_F(ThermalTest, RetainsLooperUntilThermalDestruction) {
+    ::android::wp<Looper> weak = looper;
+    looper.clear();
+    EXPECT_NE(weak.promote(), nullptr);
+    thermal.reset();
+    EXPECT_EQ(weak.promote(), nullptr);
+}
+
