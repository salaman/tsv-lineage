From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Paslawski <chris@paslawski.me>
Date: Wed, 4 Nov 2026 09:04:11 -0800
Subject: [PATCH] sensors: iio: resolve opt_scale for unnamed channels

Generic channels have an empty name even when their catalog channel count is
one. Avoid a leading separator in their opt_scale selector; retain named-axis
selectors, device-specific precedence and the existing unity default.

Use the existing final floating-point correction, without changing native IIO
units. Exercise real property lookup with process-local property overrides;
no test writes to the Android property service.

Origin: Local ThinkSmart View port
Source: https://github.com/LineageOS/android_hardware_intel_sensors-iio
Base-commit: b5134567f8b8bce819b3686d045acfc120e0159f
Apply in filename order within this project.

---
diff --git a/description.c b/description.c
index e04513d..6c46334 100644
--- a/description.c
+++ b/description.c
@@ -169,6 +169,22 @@ int sensor_get_fl_prop (int s, const char* sel, float* val)
 }
 
 
+int sensor_get_opt_scale (int s, int c, float* val)
+{
+	int i = sensor[s].catalog_index;
+	const char* name = sensor_catalog[i].num_channels ?
+		sensor_catalog[i].channel[c].name : "";
+	char suffix[MAX_NAME_SIZE];
+
+	if (name[0])
+		snprintf(suffix, sizeof(suffix), "%s.opt_scale", name);
+	else
+		strcpy(suffix, "opt_scale");
+
+	return sensor_get_fl_prop(s, suffix, val);
+}
+
+
 char* sensor_get_name (int s)
 {
 	char buf[MAX_NAME_SIZE];
diff --git a/description.h b/description.h
index f1f9b5f..e8dc5c0 100644
--- a/description.h
+++ b/description.h
@@ -56,6 +56,7 @@ float		sensor_get_illumincalib (int s);
 uint32_t	sensor_get_quirks	(int s);
 int		sensor_get_prop		(int s, const char* sel, int* val);
 int		sensor_get_fl_prop	(int s, const char* sel, float* val);
+int		sensor_get_opt_scale	(int s, int c, float* val);
 int		sensor_get_order	(int s,unsigned char map[MAX_CHANNELS]);
 int		sensor_get_mounting_matrix(int s,float mounting_matrix[9]);
 int		sensor_get_available_frequencies(int s);
diff --git a/enumeration.c b/enumeration.c
index 39f30b7..2905dbc 100644
--- a/enumeration.c
+++ b/enumeration.c
@@ -720,17 +720,10 @@ static int add_sensor (int dev_num, int catalog_index, int mode)
 	 * of any previous conversions.
 	 */
 
-	if (num_channels) {
-		for (c = 0; c < num_channels; c++) {
-			ch_name = sensor_catalog[catalog_index].channel[c].name;
-			sprintf(suffix, "%s.opt_scale", ch_name);
-			if (!sensor_get_fl_prop(s, suffix, &opt_scale))
-				sensor[s].channel[c].opt_scale = opt_scale;
-		}
-        } else {
-		if (!sensor_get_fl_prop(s, "opt_scale", &opt_scale))
-			sensor[s].channel[0].opt_scale = opt_scale;
-        }
+	for (c = 0; c < (num_channels ? num_channels : 1); c++) {
+		if (!sensor_get_opt_scale(s, c, &opt_scale))
+			sensor[s].channel[c].opt_scale = opt_scale;
+	}
 
 	populate_descriptors(s, sensor_type);
 
diff --git a/sample_test.cpp b/sample_test.cpp
index 7b49838..56971f6 100644
--- a/sample_test.cpp
+++ b/sample_test.cpp
@@ -6,8 +6,12 @@
 #include <algorithm>
 #include <cmath>
 #include <cstring>
+#include <map>
+#include <string>
+#include <cutils/properties.h>
 #include <gtest/gtest.h>
 #include <hardware/sensors.h>
+#include <sys/system_properties.h>
 
 extern "C" {
 #include "common.h"
@@ -17,6 +21,23 @@ extern "C" {
 float sensor_get_max_freq(int s);
 }
 
+static std::map<std::string, std::string> property_overrides;
+
+// Keep test properties process-local; never modify the device property service.
+extern "C" int property_get(const char* key, char* value, const char* default_value) {
+    const auto override = property_overrides.find(key);
+    if (override == property_overrides.end()) {
+        const int length = __system_property_get(key, value);
+        if (length != 0) {
+            return length;
+        }
+    }
+    const char* fallback = override != property_overrides.end()
+            ? override->second.c_str() : (default_value != nullptr ? default_value : "");
+    strlcpy(value, fallback, PROPERTY_VALUE_MAX);
+    return std::strlen(value);
+}
+
 class SampleTest : public testing::Test {
 protected:
     void SetUp() override {
@@ -131,6 +152,7 @@ TEST_F(SampleTest, OnChangePollingRespectsConfiguredFrequencyCaps) {
                 found = true;
                 break;
             }
+
         }
         ASSERT_TRUE(found);
         const float cap = sensor_get_max_freq(0);
@@ -141,3 +163,60 @@ TEST_F(SampleTest, OnChangePollingRespectsConfiguredFrequencyCaps) {
         EXPECT_EQ(sensor_get_min_delay(0), expected);
     }
 }
+
+class OptScaleTest : public SampleTest {
+protected:
+    void SetUp() override {
+        SampleTest::SetUp();
+        property_overrides.clear();
+        ASSERT_TRUE(select_sensor(SENSOR_TYPE_INTERNAL_ILLUMINANCE));
+        std::strcpy(sensor[0].internal_name, "testals");
+        property_overrides["ro.vendor.iio.illuminance.opt_scale"] = "";
+    }
+
+    void TearDown() override {
+        property_overrides.clear();
+    }
+
+    bool select_sensor(int type) {
+        for (unsigned int i = 0; i < catalog_size; ++i) {
+            if (sensor_catalog[i].type == type) {
+                sensor[0].type = type;
+                sensor[0].catalog_index = i;
+                select_transform(0);
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+TEST_F(OptScaleTest, UnnamedChannelUsesShortPropertyAndPreservesFraction) {
+    property_overrides["ro.vendor.iio.illuminance.opt_scale"] = "12.5";
+    property_overrides["ro.vendor.iio.illuminance..opt_scale"] = "99";
+    float factor = 1;
+    ASSERT_EQ(sensor_get_opt_scale(0, 0, &factor), 0);
+    EXPECT_FLOAT_EQ(factor, 12.5f);
+}
+
+TEST_F(OptScaleTest, MissingPropertyPreservesUnityDefault) {
+    float factor = 1;
+    EXPECT_EQ(sensor_get_opt_scale(0, 0, &factor), -1);
+    EXPECT_FLOAT_EQ(factor, 1);
+}
+
+TEST_F(OptScaleTest, DeviceSpecificPropertyStillTakesPrecedence) {
+    property_overrides["ro.vendor.iio.illuminance.opt_scale"] = "12.5";
+    property_overrides["ro.vendor.iio.illuminance.testals.opt_scale"] = "2.5";
+    float factor = 1;
+    ASSERT_EQ(sensor_get_opt_scale(0, 0, &factor), 0);
+    EXPECT_FLOAT_EQ(factor, 2.5f);
+}
+
+TEST_F(OptScaleTest, NamedChannelRetainsAxisPropertyAndNegativeGain) {
+    ASSERT_TRUE(select_sensor(SENSOR_TYPE_ACCELEROMETER));
+    property_overrides["ro.vendor.iio.accel.y.opt_scale"] = "-1";
+    float factor = 1;
+    ASSERT_EQ(sensor_get_opt_scale(0, 1, &factor), 0);
+    EXPECT_FLOAT_EQ(factor, -1);
+}
