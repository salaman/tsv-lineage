diff --git a/sample_test.cpp b/sample_test.cpp
new file mode 100644
index 0000000..d80b8c6
--- /dev/null
+++ b/sample_test.cpp
@@ -0,0 +1,143 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ * Copyright (C) 2026
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <gtest/gtest.h>
+#include <hardware/sensors.h>
+
+extern "C" {
+#include "common.h"
+#include "description.h"
+#include "enumeration.h"
+#include "transform.h"
+float sensor_get_max_freq(int s);
+}
+
+class SampleTest : public testing::Test {
+protected:
+    void SetUp() override {
+        std::memset(&sensor[0], 0, sizeof(sensor[0]));
+        std::memset(&sensor_desc[0], 0, sizeof(sensor_desc[0]));
+        sensor_count = 1;
+        sensor[0].type = SENSOR_TYPE_PROXIMITY;
+        sensor[0].proximity_near_level = 3;
+        sensor[0].proximity_far_level = 2;
+        sensor_desc[0].maxRange = 5;
+        select_transform(0);
+    }
+
+    int sample(float raw, float* output = nullptr) {
+        sensors_event_t event{};
+        event.data[0] = raw;
+        int result = sensor[0].ops.finalize(0, &event);
+        if (output != nullptr) {
+            *output = event.data[0];
+        }
+        return result;
+    }
+};
+
+TEST_F(SampleTest, FirstNearZeroIsReported) {
+    float value;
+    EXPECT_EQ(sample(3, &value), 1);
+    EXPECT_FLOAT_EQ(value, 0);
+    EXPECT_EQ(sample(4), 0);
+}
+
+TEST_F(SampleTest, FarHasAndroidMaximumRange) {
+    float value;
+    EXPECT_EQ(sample(0.125f, &value), 1);
+    EXPECT_FLOAT_EQ(value, 5);
+    EXPECT_EQ(sample(0.1875f), 0);
+}
+
+TEST_F(SampleTest, ThresholdHysteresisPreservesBothStates) {
+    float value;
+    EXPECT_EQ(sample(1), 1);
+    EXPECT_EQ(sample(2.5f), 0);
+    EXPECT_EQ(sample(3, &value), 1);
+    EXPECT_FLOAT_EQ(value, 0);
+    EXPECT_EQ(sample(2.5f), 0);
+    EXPECT_EQ(sample(2, &value), 1);
+    EXPECT_FLOAT_EQ(value, 5);
+}
+
+TEST_F(SampleTest, FirstHysteresisBandSampleIsFar) {
+    float value;
+    EXPECT_EQ(sample(2.5f, &value), 1);
+    EXPECT_FLOAT_EQ(value, 5);
+}
+
+TEST_F(SampleTest, InvalidSampleDoesNotChangePreviousState) {
+    EXPECT_EQ(sample(4), 1);
+    EXPECT_EQ(sample(NAN), 0);
+    EXPECT_EQ(sample(INFINITY), 0);
+    EXPECT_EQ(sample(4), 0);
+    float value;
+    EXPECT_EQ(sample(1, &value), 1);
+    EXPECT_FLOAT_EQ(value, 5);
+}
+
+TEST_F(SampleTest, FirstDarkLightSampleIsReported) {
+    sensor[0].type = SENSOR_TYPE_INTERNAL_ILLUMINANCE;
+    float value;
+    EXPECT_EQ(sample(0, &value), 1);
+    EXPECT_FLOAT_EQ(value, 0);
+    EXPECT_EQ(sample(0), 0);
+    EXPECT_EQ(sample(0.6f, &value), 1);
+    EXPECT_NEAR(value, 0.6f, 0.011f);
+}
+
+TEST_F(SampleTest, InvalidLightSampleDoesNotBecomeDarkness) {
+    sensor[0].type = SENSOR_TYPE_INTERNAL_ILLUMINANCE;
+    EXPECT_EQ(sample(NAN), 0);
+    EXPECT_EQ(sample(INFINITY), 0);
+    EXPECT_EQ(sensor[0].event_count, 0);
+    EXPECT_EQ(sample(0), 1);
+}
+
+TEST_F(SampleTest, MissingSysfsValueIsNotAZeroReading) {
+    sensor[0].dev_num = -1;
+    bool found = false;
+    for (unsigned int i = 0; i < catalog_size; ++i) {
+        if (sensor_catalog[i].type == SENSOR_TYPE_PROXIMITY) {
+            sensor[0].catalog_index = i;
+            found = true;
+            break;
+        }
+    }
+    ASSERT_TRUE(found);
+    sensor[0].channel[0].raw_path_present = 1;
+    sensor[0].scale = 1;
+    sensor[0].channel[0].opt_scale = 1;
+    EXPECT_TRUE(std::isnan(acquire_immediate_float_value(0, 0)));
+}
+
+TEST_F(SampleTest, OnChangePollingRespectsConfiguredFrequencyCaps) {
+    const int types[] = {SENSOR_TYPE_INTERNAL_ILLUMINANCE, SENSOR_TYPE_PROXIMITY};
+    for (int type : types) {
+        SCOPED_TRACE(type);
+        sensor[0].type = type;
+        sensor[0].mode = MODE_POLL;
+        sensor_desc[0].flags = SENSOR_FLAG_ON_CHANGE_MODE;
+        bool found = false;
+        for (unsigned int i = 0; i < catalog_size; ++i) {
+            if (sensor_catalog[i].type == type) {
+                sensor[0].catalog_index = i;
+                found = true;
+                break;
+            }
+        }
+        ASSERT_TRUE(found);
+        const float cap = sensor_get_max_freq(0);
+        ASSERT_TRUE(std::isfinite(cap));
+        ASSERT_GE(cap, 0.1f);
+        const int32_t expected = std::max<int32_t>(
+                200000, static_cast<int32_t>(std::ceil(1000000.0f / cap)));
+        EXPECT_EQ(sensor_get_min_delay(0), expected);
+    }
+}
