From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Paslawski <chris@paslawski.me>
Date: Sun, 25 Oct 2026 21:40:34 -0700
Subject: [PATCH] codec2: map non-dmabuf allocations through their allocator

Selecting DMA-BUF heaps does not make every linear allocation a DMA-BUF
allocation. The BLOB allocator wraps gralloc handles, which the specialized
C2DmaBufAllocator::Map rejects with C2_BAD_VALUE. This breaks reading codec
configuration buffers when the selected linear allocator is BLOB.

Check the allocation's handle before using the specialized DMA-BUF mapper
in both read and write views. Preserve virtual mapping for ION and other
allocation types, and retain the mapping callbacks for DMA-BUF allocations.
Add a BLOB block regression to the existing codec2_vndk_test suite.

Origin: Local ThinkSmart View port
Source: https://github.com/LineageOS/android_frameworks_av
License: Apache-2.0 (modified upstream sources)
Base-commit: 937eb9047ec2f88620f1f6a4d9e407f6c869d91a
Apply in filename order within this project.

---
diff --git a/media/codec2/tests/vndk/C2BufferTest.cpp b/media/codec2/tests/vndk/C2BufferTest.cpp
index 0cfb465..d0eda12 100644
--- a/media/codec2/tests/vndk/C2BufferTest.cpp
+++ b/media/codec2/tests/vndk/C2BufferTest.cpp
@@ -16,10 +16,12 @@
 
 #include <gtest/gtest.h>
 
+#include <C2AllocatorBlob.h>
 #include <C2AllocatorGralloc.h>
 #include <C2Buffer.h>
 #include <C2BufferPriv.h>
 #include <C2Config.h>
+#include <C2DmaBufAllocator.h>
 #include <C2ParamDef.h>
 #include <C2PlatformSupport.h>
 
@@ -370,6 +372,37 @@ TEST_F(C2BufferTest, LinearAllocationTest) {
     }
 }
 
+TEST_F(C2BufferTest, BlobBlockReadMappingTest) {
+    constexpr size_t kCapacity = 4096u;
+    constexpr size_t kOffset = 17u;
+    constexpr size_t kLength = 61u;
+    auto allocator = std::make_shared<C2AllocatorBlob>(C2PlatformAllocatorStore::BLOB);
+    C2BasicLinearBlockPool pool(allocator);
+    std::shared_ptr<C2LinearBlock> block;
+    ASSERT_EQ(C2_OK, pool.fetchLinearBlock(
+            kCapacity, {C2MemoryUsage::CPU_READ, C2MemoryUsage::CPU_WRITE}, &block));
+    ASSERT_TRUE(block);
+    ASSERT_TRUE(C2AllocatorBlob::CheckHandle(block->handle()));
+    ASSERT_FALSE(C2DmaBufAllocator::CheckHandle(block->handle()));
+
+    {
+        C2WriteView view = block->map().get();
+        ASSERT_EQ(C2_OK, view.error());
+        ASSERT_NE(nullptr, view.data());
+        for (size_t i = 0; i < kCapacity; ++i) {
+            view.data()[i] = i % 251u;
+        }
+    }
+
+    C2ReadView view = block->share(kOffset, kLength, C2Fence()).map().get();
+    ASSERT_EQ(C2_OK, view.error());
+    ASSERT_NE(nullptr, view.data());
+    ASSERT_EQ(kLength, view.capacity());
+    for (size_t i = 0; i < kLength; ++i) {
+        EXPECT_EQ((i + kOffset) % 251u, view.data()[i]) << " at i = " << i;
+    }
+}
+
 TEST_F(C2BufferTest, BlockPoolTest) {
     constexpr size_t kCapacity = 1024u * 1024u;
 
diff --git a/media/codec2/vndk/C2Buffer.cpp b/media/codec2/vndk/C2Buffer.cpp
index b22119f..ca55a51 100644
--- a/media/codec2/vndk/C2Buffer.cpp
+++ b/media/codec2/vndk/C2Buffer.cpp
@@ -1253,7 +1253,8 @@ C2Acquirable<C2ReadView> _C2Block1DImpl::mapReadView(
     void *base = nullptr;
     c2_status_t error = C2_OK;
     C2MemoryUsage usage{C2MemoryUsage::CPU_READ, 0};
-    if (android::C2HandleIon::IsUsed()) {
+    if (android::C2HandleIon::IsUsed() ||
+        !android::C2DmaBufAllocator::CheckHandle(mAllocation->handle())) {
         error = mAllocation->map(
                 offset, len, usage, nullptr, &base);
     } else {
@@ -1282,7 +1283,8 @@ C2Acquirable<C2WriteView> _C2Block1DImpl::mapWriteView(
     void *base = nullptr;
     c2_status_t error = C2_OK;
     C2MemoryUsage usage{C2MemoryUsage::CPU_READ, C2MemoryUsage::CPU_WRITE};
-    if (android::C2HandleIon::IsUsed()) {
+    if (android::C2HandleIon::IsUsed() ||
+        !android::C2DmaBufAllocator::CheckHandle(mAllocation->handle())) {
         error = mAllocation->map(
                 offset, len, usage, nullptr, &base);
     } else {
