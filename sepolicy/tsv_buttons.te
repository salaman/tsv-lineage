# Mic-mute button + camera privacy slider -> KEY_POWER (see buttons/tsv-buttons.c)
type tsv_buttons, domain;
type tsv_buttons_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tsv_buttons)

allow tsv_buttons input_device:dir r_dir_perms;
allow tsv_buttons input_device:chr_file r_file_perms;
allow tsv_buttons uhid_device:chr_file rw_file_perms;
allow tsv_buttons self:capability2 block_suspend;
get_prop(tsv_buttons, tsv_buttons_prop)
