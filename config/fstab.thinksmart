/dev/block/by-name/system /system erofs ro,noatime wait,first_stage_mount
/dev/block/by-name/vendor /vendor ext4 ro,noatime wait,first_stage_mount
/dev/block/by-name/oem /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 wait,check,first_stage_mount
/dev/block/by-name/userdata /data ext4 nosuid,nodev,noatime,discard wait,latemount,check,quota,fileencryption=aes-256-xts:aes-256-cts:v2
/dev/block/by-name/cache /cache ext4 nosuid,nodev,noatime wait,check
/dev/block/by-name/persist /mnt/vendor/persist ext4 ro,nosuid,nodev,noatime wait
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/zram0 none swap defaults zramsize=50%,max_comp_streams=-1
