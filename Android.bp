soong_namespace {
}

prebuilt_etc {
    name: "fstab.thinksmart",
    src: "config/fstab.thinksmart",
    vendor: true,
    ramdisk_available: true,
    recovery_available: true,
}

prebuilt_etc {
    name: "init.thinksmart.rc",
    src: "config/init.thinksmart.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.thinksmart.rc",
    src: "config/init.recovery.thinksmart.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "powerhint.json",
    src: "config/powerhint.json",
    vendor: true,
}
