soong_namespace {
}

prebuilt_etc {
    name: "fstab.thinksmart",
    src: "config/fstab.thinksmart",
    vendor: true,
    ramdisk_available: true,
    recovery_available: true,
}

prebuilt_etc {
    name: "init.thinksmart.rc",
    src: "config/init.thinksmart.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.thinksmart.rc",
    src: "config/init.recovery.thinksmart.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "powerhint.json",
    src: "config/powerhint.json",
    vendor: true,
}

prebuilt_etc {
    name: "libcamera_camera_hal.yaml",
    src: "config/camera_hal.yaml",
    filename: "camera_hal.yaml",
    sub_dir: "libcamera",
    vendor: true,
}

prebuilt_etc {
    name: "libcamera_ipa_simple_s5kc505a.yaml",
    src: "config/s5kc505a.yaml",
    filename: "s5kc505a.yaml",
    sub_dir: "libcamera/ipa/simple",
    vendor: true,
}
